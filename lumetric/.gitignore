# =============================================================================
# LUMETRIC CLIENT NEXT.JS / CAPACITOR (.gitignore)
# Strict exclusion rules to prevent leakage of credentials, keys, tokens & configs
# =============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js & static exports
/.next/
/out/
/build

# Security & Secrets Prevention
.env*
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*credentials*
*secret*
*.token

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel & Catalyst
.vercel
.catalyst/

# TypeScript & OS
*.tsbuildinfo
next-env.d.ts
.DS_Store
Thumbs.db
