# =============================================================================
# Lumetric Serverless Backend Environment Configuration (.env.example)
# =============================================================================
# Copy this file to .env for local development or configure these variables
# directly in the Zoho Catalyst Web Console under:
# Cloud Functions > lumetric_server > Configuration > Environment Variables.
# NEVER commit the actual .env file or production credentials to Git!
# =============================================================================

# 1. Zoho Enterprise SMTP Configuration (Transporter credentials)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=security@techexon.app
SMTP_PASS=your_rotated_zoho_smtp_app_password_here
SMTP_FROM_NAME=Lumetric
SENDER_EMAIL=security@techexon.app

# 2. Cryptographic Security & JWT Signature Secret
# Must be a cryptographically secure random string with at least 32 characters
LUMETRIC_JWT_SECRET=your_hyper_secure_jwt_secret_min_32_chars_here

# 3. Optional External Transporter Fallbacks
RESEND_API_KEY=
RESEND_FROM=
